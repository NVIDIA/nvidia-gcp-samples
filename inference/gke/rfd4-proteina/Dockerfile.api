# syntax=docker/dockerfile:1
FROM rfd4-runtime:build
COPY api/ /opt/rfd4-api/
RUN uv pip install --system --no-cache -r /opt/rfd4-api/requirements.txt && python -m pip check
ENV PROJECT_ROOT=/opt/rfd4 DATA_PATH=/workspace/models CLUSTER=local \
    PYTHONPATH=/opt/rfd4-api HOME=/workspace OMP_NUM_THREADS=4 \
    HF_HOME=/workspace/cache/huggingface PYTHONUNBUFFERED=1 \
    NVIDIA_DRIVER_CAPABILITIES=compute,utility
WORKDIR /workspace
EXPOSE 8000
CMD ["uvicorn", "app.api:app", "--host", "0.0.0.0", "--port", "8000", "--workers", "1"]
